--- pkg/stacktrace/resolver.go
+++ pkg/stacktrace/resolver.go
@@ -53,6 +53,7 @@ func (r *Resolver) readMaps(pid int) ([]MemoryMap, error) {
 	mapsFile := fmt.Sprintf("/proc/%d/maps", pid)
 	f, err := os.Open(mapsFile)
 	if err != nil {
+		fmt.Printf("ERROR readMaps: %v\n", err)
 		return nil, err
 	}
 	defer f.Close()
